# ── Variables d'environnement du backend ──────────────────────────
# Copier ce fichier en .env et adapter les valeurs.
# Ne JAMAIS committer le vrai fichier .env (secrets).

# Clé secrète de signature des jetons JWT.
# OBLIGATOIRE en production : générer une valeur aléatoire longue, p.ex.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=remplacez-moi-par-une-cle-aleatoire-longue

# Connexion PostgreSQL (Data Warehouse en étoile)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pfa_maladies

# Origines autorisées par CORS (séparées par des virgules, sans espace superflu)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
