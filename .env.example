# ═══════════════════════════════════════════════════════════════
# Variables d'environnement pour docker compose
# Copier ce fichier en .env puis adapter les valeurs.
#   cp .env.example .env
# Ne JAMAIS committer le vrai fichier .env (secrets).
# ═══════════════════════════════════════════════════════════════

# ── Base de données PostgreSQL ────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pfa_maladies

# ── Backend ───────────────────────────────────────────────────
# Clé de signature des jetons JWT — OBLIGATOIRE de la changer en prod :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=pfa2026-CHANGEZ-MOI-en-production

# Origines autorisées par CORS (séparées par des virgules, sans espace)
CORS_ORIGINS=http://localhost:3000

# ── Réseau / ports publiés sur l'hôte ─────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# URL de l'API appelée depuis le navigateur (port publié du backend)
NEXT_PUBLIC_API_URL=http://localhost:8000
